# Token from @BotFather
BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot (empty = anyone!)
ALLOWED_IDS=376986805
# Netscape cookies.txt exported from a (secondary!) YouTube account, path relative to the app dir.
# Needed on datacenter IPs (Oracle): otherwise YouTube answers "Sign in to confirm you're not a bot".
YTDLP_COOKIES=var/cookies.txt
# Optional proxy for YouTube requests, e.g. socks5://127.0.0.1:1080
YTDLP_PROXY=
# Target AAC bitrate when re-encoding is needed (original m4a is sent as is when it fits 48 MB)
AUDIO_BITRATE_KBPS=128
